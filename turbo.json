{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_PORT",
        "DATABASE_URL",
        "API_INTERNAL_URL",
        "APP_ORIGIN",
        "AUTH_GATEWAY_SECRET",
        "TRUSTED_CLIENT_IP_HEADER",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_WEBSOCKET_URL",
        "NEXT_PUBLIC_USE_MOCK"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "@comandinha/api#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@comandinha/api#test": {
      "dependsOn": ["^test"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@comandinha/api#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@comandinha/api#test:e2e": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@comandinha/api#test:integration": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
