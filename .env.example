# Local development placeholders only. Never use these credentials in production.
POSTGRES_USER=comandinha
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=comandinha
POSTGRES_PORT=5432
DATABASE_URL=postgresql://comandinha:change-me-local-only@127.0.0.1:5432/comandinha?schema=public
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
APP_ORIGIN=http://localhost:3000
# Generate a unique random value with at least 32 bytes of entropy before use.
AUTH_GATEWAY_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Only for non-Vercel production: use a header that the trusted ingress always overwrites.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Change to true only for an intentional local seed run. It creates the owner,
# restaurant, 3 tables, 4 menu categories and 8 example products in loopback PostgreSQL.
ALLOW_LOCAL_DEMO_SEED=false
# Used only by the explicit local demo seed. Leave blank until you choose local credentials.
DEMO_OWNER_NAME=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_RESTAURANT_NAME=
DEMO_RESTAURANT_SLUG=
