generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  slug              String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  memberships       Membership[]
  catalogCategories CatalogCategory[]
  catalogProducts   CatalogProduct[]
  tables            RestaurantTable[]
  orders            Order[]
  diningSessions    DiningSession[]
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Membership {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  restaurantId String         @db.Uuid
  role         MembershipRole @default(STAFF)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions     AdminSession[]

  @@unique([userId, restaurantId])
  @@index([restaurantId, isActive])
}

model AdminSession {
  id           String     @id @default(uuid()) @db.Uuid
  tokenHash    String     @unique
  membershipId String     @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model CatalogCategory {
  id             String           @id @default(uuid()) @db.Uuid
  restaurantId   String           @db.Uuid
  name           String
  nameNormalized String
  description    String?
  imageUrl       String?
  displayOrder   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products       CatalogProduct[]

  @@unique([restaurantId, nameNormalized])
  @@unique([id, restaurantId])
  @@index([restaurantId, displayOrder, name])
}

model CatalogProduct {
  id              String          @id @default(uuid()) @db.Uuid
  restaurantId    String          @db.Uuid
  categoryId      String          @db.Uuid
  name            String
  description     String?
  priceInCents    Int
  imageUrl        String?
  available       Boolean         @default(true)
  featured        Boolean         @default(false)
  dietaryTags     String[]        @default([])
  prepTimeMinutes Int?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        CatalogCategory @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orderItems      OrderItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId, isActive, categoryId])
  @@index([restaurantId, isActive, name])
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum DiningSessionStatus {
  OPEN
  CLOSED
}

model DiningSession {
  id                 String              @id @default(uuid()) @db.Uuid
  restaurantId       String              @db.Uuid
  tableId            String              @db.Uuid
  status             DiningSessionStatus @default(OPEN)
  openedAt           DateTime            @default(now())
  closedAt           DateTime?
  closedTotalInCents Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table              RestaurantTable     @relation(fields: [tableId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orders             Order[]

  @@unique([id, restaurantId])
  @@unique([id, tableId, restaurantId])
  @@index([restaurantId, status, openedAt])
  @@index([tableId, status, openedAt])
}

model RestaurantTable {
  id             String          @id @default(uuid()) @db.Uuid
  restaurantId   String          @db.Uuid
  name           String          @db.VarChar(80)
  publicCode     String          @unique @db.VarChar(64)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders         Order[]
  diningSessions DiningSession[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, name])
  @@index([restaurantId, isActive, name])
}

model Order {
  id              String          @id @default(uuid()) @db.Uuid
  restaurantId    String          @db.Uuid
  tableId         String          @db.Uuid
  diningSessionId String?         @db.Uuid
  idempotencyKey  String?         @db.Uuid
  status          OrderStatus     @default(PENDING)
  notes           String?         @db.VarChar(200)
  totalInCents    Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table           RestaurantTable @relation(fields: [tableId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  diningSession   DiningSession?  @relation(fields: [diningSessionId, tableId, restaurantId], references: [id, tableId, restaurantId], onDelete: Restrict)
  items           OrderItem[]

  @@unique([id, restaurantId])
  @@unique([tableId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([tableId, createdAt])
  @@index([diningSessionId, restaurantId, status])
}

model OrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  restaurantId     String         @db.Uuid
  orderId          String         @db.Uuid
  productId        String         @db.Uuid
  nameSnapshot     String         @db.VarChar(120)
  unitPriceInCents Int
  quantity         Int
  notes            String?        @db.VarChar(200)
  lineTotalInCents Int
  createdAt        DateTime       @default(now())
  order            Order          @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  product          CatalogProduct @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@index([restaurantId, orderId])
  @@index([productId, restaurantId])
}
