generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  slug             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  memberships      Membership[]
  catalogCategories CatalogCategory[]
  catalogProducts   CatalogProduct[]
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Membership {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  restaurantId String         @db.Uuid
  role         MembershipRole @default(STAFF)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions     AdminSession[]

  @@unique([userId, restaurantId])
  @@index([restaurantId, isActive])
}

model AdminSession {
  id           String     @id @default(uuid()) @db.Uuid
  tokenHash    String     @unique
  membershipId String     @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model CatalogCategory {
  id             String           @id @default(uuid()) @db.Uuid
  restaurantId   String           @db.Uuid
  name           String
  nameNormalized String
  description    String?
  imageUrl       String?
  displayOrder   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products       CatalogProduct[]

  @@unique([restaurantId, nameNormalized])
  @@unique([id, restaurantId])
  @@index([restaurantId, displayOrder, name])
}

model CatalogProduct {
  id              String          @id @default(uuid()) @db.Uuid
  restaurantId    String          @db.Uuid
  categoryId      String          @db.Uuid
  name            String
  description     String?
  priceInCents    Int
  imageUrl        String?
  available       Boolean         @default(true)
  featured        Boolean         @default(false)
  dietaryTags     String[]        @default([])
  prepTimeMinutes Int?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        CatalogCategory @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@index([restaurantId, isActive, categoryId])
  @@index([restaurantId, isActive, name])
}
