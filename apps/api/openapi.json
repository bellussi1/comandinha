{
  "openapi": "3.0.0",
  "paths": {
    "/auth/sessions": {
      "post": {
        "operationId": "AuthController_create",
        "parameters": [
          {
            "name": "x-comandinha-client-key",
            "in": "header",
            "description": "Hash da origem confiável encaminhado pelo gateway; compõe o limite por conta/origem.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-comandinha-gateway-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedSessionDto"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas ou gateway não autorizado."
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipSelectionRequiredDto"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsDto"
                }
              }
            }
          }
        },
        "summary": "Cria uma sessão administrativa pelo gateway same-origin",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sessions/current": {
      "get": {
        "operationId": "AuthController_current",
        "parameters": [
          {
            "name": "x-comandinha-gateway-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMetadataDto"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, revogada ou expirada."
          }
        },
        "security": [
          {
            "admin-session": []
          }
        ],
        "summary": "Valida a sessão administrativa atual",
        "tags": [
          "auth"
        ]
      },
      "delete": {
        "operationId": "AuthController_revoke",
        "parameters": [
          {
            "name": "x-comandinha-gateway-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sessão revogada."
          },
          "401": {
            "description": "Sessão ausente, revogada ou expirada."
          }
        },
        "security": [
          {
            "admin-session": []
          }
        ],
        "summary": "Revoga a sessão administrativa atual",
        "tags": [
          "auth"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A API está ativa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ],
                      "example": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        "summary": "Verifica se a API está ativa",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A API e o banco de dados estão disponíveis.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ],
                      "example": "ready"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "O banco de dados não está disponível.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "not-ready"
                      ],
                      "example": "not-ready"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        "summary": "Verifica a disponibilidade da API e do banco de dados",
        "tags": [
          "health"
        ]
      }
    },
