  "info": {
    "title": "Comandinha API",
    "description": "API do Comandinha para gerenciamento de pedidos e restaurantes.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "admin-session": {
        "scheme": "bearer",
        "bearerFormat": "opaque session token",
        "type": "http"
      }
    },
    "schemas": {
      "CreateSessionRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "owner@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          },
          "restaurantSlug": {
            "type": "string",
            "example": "my-restaurant",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "SessionRestaurantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "SessionMembershipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "STAFF"
            ]
          }
        },
        "required": [
          "id",
          "role"
        ]
      },
      "CreatedSessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUserDto"
          },
          "restaurant": {
            "$ref": "#/components/schemas/SessionRestaurantDto"
          },
          "membership": {
            "$ref": "#/components/schemas/SessionMembershipDto"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionToken": {
            "type": "string",
            "description": "Opaque session secret; returned only to the trusted Next.js gateway."
          }
        },
        "required": [
          "user",
          "restaurant",
          "membership",
          "expiresAt",
          "sessionToken"
        ]
      },
      "MembershipChoiceDto": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "STAFF"
            ]
          },
          "restaurant": {
            "$ref": "#/components/schemas/SessionRestaurantDto"
          }
        },
        "required": [
          "membershipId",
          "role",
          "restaurant"
        ]
      },
      "MembershipSelectionRequiredDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "RESTAURANT_SELECTION_REQUIRED"
            ]
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipChoiceDto"
            }
          }
        },
        "required": [
          "code",
          "memberships"
        ]
      },
      "TooManyRequestsDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 429
          },
          "message": {
            "type": "string",
            "example": "ThrottlerException: Too Many Requests"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "SessionMetadataDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUserDto"
          },
          "restaurant": {
            "$ref": "#/components/schemas/SessionRestaurantDto"
          },
          "membership": {
            "$ref": "#/components/schemas/SessionMembershipDto"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "restaurant",
          "membership",
          "expiresAt"
        ]
      },
      "CatalogCategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "nameNormalized": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "displayOrder": {
            "type": "number"
          },
          "productCount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "restaurantId",
          "name",
          "nameNormalized",
          "displayOrder",
          "productCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateCatalogCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Bebidas"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "example": "https://example.com/menu.jpg"
          },
          "displayOrder": {
            "type": "number",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "Ordem da categoria. O valor padrão é zero."
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCatalogCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "nullable": true
          },
          "displayOrder": {
            "type": "number",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "CatalogProductResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
