{
  "name": "@comandinha/api",
  "version": "0.1.0",
  "description": "API do Comandinha",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "pnpm prisma:generate && nest start --watch",
    "start": "nest start",
    "start:dev": "pnpm prisma:generate && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "pnpm prisma:generate && vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "pnpm prisma:generate && vitest run --config ./vitest.config.integration.ts",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "openapi:export": "pnpm prisma:generate && tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "^5.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
