{
  "name": "comandinha",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "infra:down": "docker compose down",
    "api:client:generate": "pnpm --filter @comandinha/api openapi:export && pnpm --filter @comandinha/api-client generate",
    "api:client:check": "pnpm --filter @comandinha/api prisma:generate && node scripts/check-api-client.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm test:dev-script && pnpm test:client-script && pnpm test:ci-health-script && pnpm test:docs && pnpm --filter @comandinha/api-client test:consumer && turbo run test",
    "test:integration": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run test:integration",
    "test:dev-script": "node --test scripts/dev.test.mjs",
    "test:client-script": "node --test scripts/check-api-client.test.mjs",
    "test:ci-health-script": "node --test scripts/check-ci-health.test.mjs",
    "test:docs": "node --test scripts/readme-check.test.mjs && node scripts/check-readme.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "turbo": "2.11.7"
  }
}
